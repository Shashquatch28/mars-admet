# Copy to .env and fill in. Never commit the real .env.
#
# Backend only (read by api/app/core/config.py, and by ml/tracking for W&B).
# Sections marked "Prod infra", "Monitoring" and the CI/deploy keys are reserved
# for the Module 10 deployment and are not read by any code yet. The frontend has
# its own file: frontend/.env.example (VITE_API_BASE).

# --- Local dev (docker-compose defaults, override for prod) ---
DATABASE_URL=postgresql+asyncpg://mars:mars_dev_password@localhost:55432/mars_dev  # host port 55432: 5432 AND 5433 were both taken by native Postgres services on the dev machine (documentation/AIMS/mistakes.md, on milestone/m2-kermt)
REDIS_URL=redis://localhost:6379/0

# --- Object storage (local: MinIO / prod: Cloudflare R2) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=mars_minio
S3_SECRET_ACCESS_KEY=mars_minio_password
S3_BUCKET_UPLOADS=mars-batch-uploads
S3_BUCKET_CHECKPOINTS=mars-model-checkpoints

# --- Prod infra (fill in when deploying) ---
NEON_DATABASE_URL=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
# Serving: Google Cloud Run (backend + async worker) + Cloud Tasks queue. Deploy
# via GitHub Actions -> Artifact Registry -> `gcloud run deploy` (Module 10).
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_RUN_SERVICE_BACKEND=mars-api
CLOUD_RUN_SERVICE_WORKER=mars-worker
CLOUD_TASKS_QUEUE=mars-batch
GCP_SA_KEY_JSON=                      # CI service-account key (GitHub Actions secret; never committed)
VERCEL_TOKEN=                         # only if the blueprint's Vercel frontend is kept; frontend ADR-025 serves the SPA from the API container instead

# --- Auth (Module 8/13 stub accounts) ---
SECRET_KEY=                          # signs password-reset tokens (itsdangerous); MUST be set in prod
# Server-side sessions in Redis (Module 13) — NOT JWT. Key: session:{token} -> user_id,
# sliding TTL refreshed on activity. Session store reuses REDIS_URL above.
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=mars_session
SESSION_COOKIE_SECURE=false          # true in prod (HTTPS only)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # comma-separated SPA origin(s); set the deployed frontend origin in prod. "*" disables credentials
PASSWORD_HASH_SCHEME=bcrypt          # via the `bcrypt` lib directly, NOT passlib (broken on bcrypt>=4.1, see AIMS/mistakes.md)
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
RESEND_API_KEY=                      # Module 13 password-reset email (Module 10 infra table)

# --- Rate limiting ---
RATE_LIMIT_ANON_PER_MINUTE=60
TRUSTED_PROXY_HOPS=0                  # proxies in front of the API that append to X-Forwarded-For; 0 = the socket peer is the client. Cloud Run: 1 (verify after deploy)
MAX_CONCURRENT_PREDICTIONS=0          # 0 = one per CPU this process can use; on Cloud Run set it to the service's vCPU count
BATCH_SIZE_CAP=50000
BATCH_INTERACTIVE_THRESHOLD=100       # larger files are queued and report progress; a real prediction costs 0.2-0.5 s

# --- Model serving ---
MODEL_VERSION=v0.2.0-dev
MODEL_ARTIFACT_DIR=./ml/artifacts     # ml/serve/ registry root (Module 8 routing table)
ML_DATA_CACHE_DIR=./ml/data/cache     # FeatureCache root; computes-and-caches on miss for new SMILES at serving time
PREDICTION_CACHE_TTL_SECONDS=172800   # 48h, Module 8 retention policy
MARS_APPLY_PLATT=                     # unset/0 = serve the raw XGBoost ensemble (C0, decisions.md 2026-10-08); 1 = apply the fitted Platt calibrators (not recommended)
BATCH_UPLOAD_RETENTION_HOURS=24

# --- W&B experiment tracking (ML track) ---
WANDB_API_KEY=
WANDB_PROJECT=mars-admet
WANDB_ENTITY=shashquatch

# --- Monitoring ---
SENTRY_DSN=
