# Base URL of the MARS API. Leave unset and the UI has no API: it says so
# and shows no values (Run, Save and Batch upload are off).
#
# Use "/api" in development and in the production build (ADR-025): the Vite dev server proxies it to the API
# (default http://localhost:8000, from `docker compose up -d api`), so requests
# are same-origin and CORS never applies.
# VITE_API_BASE=/api
#
# Where the dev proxy forwards to, if the API is not on localhost:8000.
# Set this in the PROCESS environment for your own dev server, NOT in .env.local:
# that file is shared by every session working in this checkout, and a value
# there silently redirects all of their Vite servers too (see AGENTS.md,
# "Shared dev environment").
#   MARS_API_PROXY_TARGET=http://localhost:18000 npx vite --port 5174 --strictPort
