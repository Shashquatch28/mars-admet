# Base URL of the MARS API. Leave unset to run the UI on the illustrative
# fixture (the "design prototype" strip shows, Run is disabled).
#
# For local development use "/api": the Vite dev server proxies it to the API
# (default http://localhost:8000, from `docker compose up -d api`), so requests
# are same-origin and CORS never applies.
# VITE_API_BASE=/api
#
# Where the dev proxy forwards to, if the API is not on localhost:8000.
# MARS_API_PROXY_TARGET=http://localhost:8000
