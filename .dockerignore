# Build context = repo root (docker-compose.yml, CI: docker build -f api/Dockerfile .).
# Allowlist: only what api/Dockerfile COPYs. Everything else (ml/.venv, datasets,
# ml/runs, ml/artifacts, documentation/, .git, .env, and the frontend's node_modules/dist) stays out of the
# context. If you add a COPY to api/Dockerfile, add its path here too.
*

!contracts
!api/requirements.txt
!api/app
!ml/requirements-serving.txt
!ml/serve
!ml/featurize
!ml/models
!ml/eval
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/src
!ml/explain

**/__pycache__
**/*.pyc
**/.pytest_cache
**/.venv
